# Normalise all text files to LF in the repo; checkout as CRLF on Windows
* text=auto eol=lf

# Explicitly mark these as text
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.env   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf

# Binary files — no conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
